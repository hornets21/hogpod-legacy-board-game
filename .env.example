# ==========================================
# Hogpod Legacy - Environment Variables Template
# ==========================================

# 1. Railway Backend API & Discord Config
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 2. Base App URL (Local / Production)
NEXT_PUBLIC_APP_URL=http://localhost:3005

# 3. Firebase Client Config (จาก Firebase Console -> Project Settings -> Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# 4. Firebase Admin Config (Optional: Service Account JSON string)
FIREBASE_SERVICE_ACCOUNT_KEY=
