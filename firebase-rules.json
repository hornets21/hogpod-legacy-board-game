{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('meta/hostUid').val() === auth.uid)",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid)"
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('rooms/' + $roomCode + '/meta/hostUid').val() === auth.uid)"
          }
        },
        "spectators": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && $uid === auth.uid"
          }
        },
        "gameState": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms/' + $roomCode + '/meta/hostUid').val() === auth.uid"
        },
        "actions": {
          ".read": "auth != null && root.child('rooms/' + $roomCode + '/meta/hostUid').val() === auth.uid",
          ".write": "auth != null && root.child('rooms/' + $roomCode + '/players/' + auth.uid).exists()"
        }
      }
    }
  }
}
